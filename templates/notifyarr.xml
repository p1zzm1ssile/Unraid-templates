<?xml version="1.0"?>
<Container version="2">
  <Name>notifyarr</Name>
  <Repository>ghcr.io/p1zzm1ssile/notifyarr:latest</Repository>
  <Registry>https://github.com/p1zzm1ssile/Notifyarr/pkgs/container/notifyarr</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/p1zzm1ssile/Notifyarr/issues</Support>
  <TemplateURL>https://raw.githubusercontent.com/p1zzm1ssile/unraid-templates/main/templates/notifyarr.xml</TemplateURL>
  <Project>https://github.com/p1zzm1ssile/Notifyarr</Project>
  <Overview>Alerts for your Docker containers and Unraid server, sent to Telegram and/or email: crashes, unhealthy containers, error logs, security events, disk/array/parity/mover problems, UPS, SMART, reboots and more. Every check can be switched off. Set up Telegram, email and the password in the LAN-only web GUI after first start. Report-only: host folders are mounted read-only and nothing is ever deleted or changed. Never expose this container to the internet. Free forever: no paid tiers, no Pro account, no subscriptions.</Overview>
  <Category>Tools: Status:Stable</Category>
  <WebUI>http://[IP]:[PORT:8484]/</WebUI>
  <Icon>https://raw.githubusercontent.com/p1zzm1ssile/Notifyarr/main/docs/icon.png</Icon>
  <ExtraParams>--security-opt no-new-privileges:true --memory=192m --label notifyarr.enable=false</ExtraParams>
  <Config Name="Web GUI port (LAN only)" Target="8484" Default="8484" Mode="tcp" Description="Never port-forward this." Type="Port" Display="always" Required="false" Mask="false">8484</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/notifyarr" Mode="rw" Description="config.toml, trusted_ips.txt, state" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/notifyarr</Config>
  <Config Name="Docker socket (read-only)" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="ro" Description="" Type="Path" Display="advanced" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Host time" Target="/etc/localtime" Default="/etc/localtime" Mode="ro" Description="" Type="Path" Display="advanced" Required="false" Mask="false">/etc/localtime</Config>
  <Config Name="Unraid logs" Target="/host/log" Default="/var/log" Mode="ro" Description="syslog and /var/log space" Type="Path" Display="advanced" Required="false" Mask="false">/var/log</Config>
  <Config Name="Unraid notifications" Target="/host/notifications" Default="/tmp/notifications" Mode="ro" Description="" Type="Path" Display="advanced" Required="false" Mask="false">/tmp/notifications</Config>
  <Config Name="Unraid status" Target="/host/emhttp" Default="/var/local/emhttp" Mode="ro" Description="array, parity, disks, SMART" Type="Path" Display="advanced" Required="false" Mask="false">/var/local/emhttp</Config>
  <Config Name="Unraid run" Target="/host/run" Default="/var/run" Mode="ro" Description="mover status" Type="Path" Display="advanced" Required="false" Mask="false">/var/run</Config>
  <Config Name="Shares and pools" Target="/host/mnt" Default="/mnt" Mode="ro,slave" Description="free space, backups, appdata sizes" Type="Path" Display="advanced" Required="false" Mask="false">/mnt</Config>
  <Config Name="Docker containers dir" Target="/host/docker-containers" Default="/var/lib/docker/containers" Mode="ro" Description="docker.img space and log sizes" Type="Path" Display="advanced" Required="false" Mask="false">/var/lib/docker/containers</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/London" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">Europe/London</Config>
</Container>
